wave_0_per_frame1=ofs = 0;
wave_0_per_frame2=
wave_0_per_frame3=t1 = 2*sin(time/15-ofs);
wave_0_per_frame4=t2 = 2*sin(time/11-ofs);
wave_0_per_frame5=t3 = 2*sin(time/19-ofs);
wave_0_per_frame6=monitor = time;
wave_0_per_point1=
wave_0_per_point2=mul = 10;
wave_0_per_point3=t_abs = (sample)*mul;
wave_0_per_point4=ampl = 2;
wave_0_per_point5=
wave_0_per_point6=ox = ampl*sin (t_abs*68);
wave_0_per_point7=oy = ampl*cos (t_abs*28);
wave_0_per_point8=oz = 2+ampl*cos (t_abs*128);
wave_0_per_point9=
wave_0_per_point10=
wave_0_per_point11=r = min(sin(t_abs*335)+1,1);
wave_0_per_point12=g = min(sin(t_abs*783)+1,1) ;
wave_0_per_point13=b = min(sin(t_abs*456)+1,1);
wave_0_per_point14=
wave_0_per_point15=a=.5 + .02*(int(rand(10))-5);
wave_0_per_point16=
wave_0_per_point17=xang = t1;
wave_0_per_point18=yang = t2;
wave_0_per_point19=zang = t3;
wave_0_per_point20=fov = 0.12;
wave_0_per_point21=
wave_0_per_point22=
wave_0_per_point23=// Rotation um x,y,z
wave_0_per_point24=
wave_0_per_point25=mx = ox*cos(zang) - oy*sin(zang);
wave_0_per_point26=my = ox*sin(zang) + oy*cos(zang);
wave_0_per_point27=
wave_0_per_point28=ox = mx;
wave_0_per_point29=oy = my;
wave_0_per_point30=mx = ox*cos(yang) + oz*sin(yang);
wave_0_per_point31=mz = - ox*sin(yang) + oz*cos(yang);
wave_0_per_point32=ox = mx;
wave_0_per_point33=oz = mz;
wave_0_per_point34=my = oy*cos(xang) - oz*sin(xang);
wave_0_per_point35=mz = oy*sin(xang) + oz*cos(xang);
wave_0_per_point36=oy = my;
wave_0_per_point37=oz = mz;
wave_0_per_point38=
wave_0_per_point39=x = ox*fov/oz +0.5;
wave_0_per_point40=//x = (x-.5)*0.75 + 0.5;
wave_0_per_point41=y = oy*fov/oz + 0.5;
